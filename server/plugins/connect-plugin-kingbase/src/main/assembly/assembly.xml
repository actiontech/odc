<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.1 https://maven.apache.org/xsd/assembly-2.1.1.xsd">
    <id>${project.version}</id>
    <includeBaseDirectory>false</includeBaseDirectory>
    <formats>
        <format>jar</format>
    </formats>
    <fileSets>
        <fileSet>
            <directory>${project.build.directory}/classes</directory>
            <outputDirectory>/</outputDirectory>
        </fileSet>
        <!-- Keep official jar under lib/ (design: lib/ + systemPath) for pf4j consumers / inspection -->
        <fileSet>
            <directory>${project.basedir}/lib</directory>
            <outputDirectory>lib</outputDirectory>
            <includes>
                <include>kingbase8-9.0.0.jar</include>
            </includes>
        </fileSet>
    </fileSets>
    <!-- Unpack driver classes into plugin root so PluginClassLoader can load com.kingbase8.Driver
         (JarPluginLoader does not auto-mount nested lib/*.jar). Same pattern as connect-plugin-mongodb. -->
    <dependencySets>
        <dependencySet>
            <scope>system</scope>
            <includes>
                <include>com.kingbase8:kingbase8</include>
            </includes>
            <useProjectArtifact>false</useProjectArtifact>
            <unpack>true</unpack>
            <outputDirectory>/</outputDirectory>
        </dependencySet>
    </dependencySets>
</assembly>
