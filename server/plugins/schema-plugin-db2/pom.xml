<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>plugin-parent</artifactId>
        <groupId>com.oceanbase</groupId>
        <version>4.3.4-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>schema-plugin-db2</artifactId>

    <!--
      schema-plugin-db2 骨架（T-002，蓝本 schema-plugin-postgres）：
        - 仅提供 pf4j 装载骨架与 BaseSchemaPlugin → DialectType.DB2 路径；
        - 所有 Extension 方法体落到 DBAccessorUtil（占位抛 UnsupportedOperationException）；
        - 具体 SQL（SYSCAT.TABLES / SYSCAT.VIEWS 等）由 T-004 实现；
        - compat-RISK-7（schema-plugin-db2 占位 / pf4j classloader 隔离）。
    -->

    <properties>
        <root-project.basedir>${project.parent.parent.basedir}</root-project.basedir>
        <plugin.class>com.oceanbase.odc.plugin.schema.db2.Db2SchemaPlugin</plugin.class>
        <plugin.dependencies>schema-plugin-ob-mysql</plugin.dependencies>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.oceanbase</groupId>
            <artifactId>connect-plugin-db2</artifactId>
        </dependency>
        <dependency>
            <groupId>com.oceanbase</groupId>
            <artifactId>schema-plugin-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.oceanbase</groupId>
            <artifactId>schema-plugin-ob-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
        </dependency>
        <dependency>
            <groupId>com.oceanbase</groupId>
            <artifactId>odc-test</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
